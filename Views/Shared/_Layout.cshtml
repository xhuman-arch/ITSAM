<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITServiceAssetManagement</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        // Terapkan dark mode sedini mungkin (sebelum render) supaya tidak ada flash putih.
        if (localStorage.getItem("itsam-theme") === "dark") {
            document.documentElement.classList.add("dark");
        }
    </script>
</head>
<body class="font-sans text-ink bg-page">
    <div class="min-h-screen flex">
        <!-- Sidebar -->
        <aside id="sidebar" class="hidden md:flex md:flex-col w-56 flex-shrink-0 bg-surface border-r border-base py-4">
            <div class="px-4 mb-4 flex items-center justify-between">
                <a class="font-semibold text-base text-ink" asp-controller="Home" asp-action="Index">ITSAM</a>
            </div>
            <nav class="flex flex-col gap-0.5">
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "sidebar-link-active" : "sidebar-link")" asp-controller="Home" asp-action="Index">Home</a>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "sidebar-link-active" : "sidebar-link")" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    @if (User.IsInRole("IT_SERVICE") || User.IsInRole("IT_SUPPORT"))
                    {
                        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Asset" ? "sidebar-link-active" : "sidebar-link")" asp-controller="Asset" asp-action="Index">Asset</a>
                    }
                    <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Ticket" ? "sidebar-link-active" : "sidebar-link")" asp-controller="Ticket" asp-action="Index">Tiket</a>
                    @if (User.IsInRole("IT_SERVICE") || User.IsInRole("IT_SUPPORT") || User.IsInRole("PURCHASING"))
                    {
                        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ReplacementRequest" ? "sidebar-link-active" : "sidebar-link")" asp-controller="ReplacementRequest" asp-action="Index">Replacement</a>
                        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLog" ? "sidebar-link-active" : "sidebar-link")" asp-controller="AuditLog" asp-action="Index">Audit Log</a>
                    }
                }
            </nav>
        </aside>

        <!-- Main -->
        <div class="flex-1 min-w-0 flex flex-col">
            <!-- Topbar -->
            <header class="bg-surface border-b border-base">
                <div class="flex items-center justify-between h-14 px-4">
                    <button type="button" class="md:hidden p-2 rounded-md text-body2 hover:bg-gray-100 dark:hover:bg-gray-800"
                            onclick="document.getElementById('sidebar').classList.toggle('hidden'); document.getElementById('sidebar').classList.toggle('flex');">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <div class="flex-1"></div>

                    <div class="flex items-center gap-3">
                        <!-- Dark mode toggle -->
                        <button type="button" id="theme-toggle" title="Ganti tema" class="p-2 rounded-md text-body2 hover:bg-gray-100 dark:hover:bg-gray-800">
                            <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="4" stroke-width="2" />
                                <path stroke-linecap="round" stroke-width="2" d="M12 2v2M12 20v2M4 12H2M22 12h-2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                            </svg>
                            <svg id="icon-moon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
                            </svg>
                        </button>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="hidden sm:block">@await Component.InvokeAsync("NotificationBadge")</div>
                            <span class="text-sm text-body2 hidden sm:inline">Halo, @User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn-link text-sm">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="text-sm text-body2 hover:text-primary" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="text-sm text-body2 hover:text-primary" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </header>

            <main role="main" class="flex-1 p-4 md:p-6 max-w-6xl w-full mx-auto">
                @RenderBody()
            </main>

            <footer class="border-t border-base text-faint text-sm px-4 md:px-6 py-4">
                &copy; 2026 - ITServiceAssetManagement
            </footer>
        </div>
    </div>

    <script>
        const toggleBtn = document.getElementById("theme-toggle");
        const sunIcon = document.getElementById("icon-sun");
        const moonIcon = document.getElementById("icon-moon");

        function syncIcons() {
            const isDark = document.documentElement.classList.contains("dark");
            sunIcon.classList.toggle("hidden", !isDark);
            moonIcon.classList.toggle("hidden", isDark);
        }
        syncIcons();

        toggleBtn.addEventListener("click", () => {
            document.documentElement.classList.toggle("dark");
            const isDark = document.documentElement.classList.contains("dark");
            localStorage.setItem("itsam-theme", isDark ? "dark" : "light");
            syncIcons();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
