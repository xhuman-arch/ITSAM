@model ITServiceAssetManagement.Models.ReplacementRequestCreateViewModel
@{
    ViewData["Title"] = "Ajukan Penggantian Asset";
}

<h2 class="text-2xl font-semibold mb-4">Ajukan Penggantian Asset</h2>

<form asp-action="Create" method="post" class="max-w-md">
    <input type="hidden" asp-for="TicketId" />
    <div asp-validation-summary="All" class="field-error mb-2"></div>

    <div class="mb-3">
        <label asp-for="AssetId" class="form-label"></label>
        <select asp-for="AssetId" class="form-control">
            <option value="">-- Pilih Asset --</option>
            @foreach (var asset in (List<ITServiceAssetManagement.Models.Entities.Asset>)ViewBag.Assets)
            {
                <option value="@asset.Id">@asset.AssetName</option>
            }
        </select>
        <span asp-validation-for="AssetId" class="field-error"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control"></textarea>
        <span asp-validation-for="Reason" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary">Ajukan</button>
    <a asp-action="Index" class="btn-secondary">Batal</a>
</form>
