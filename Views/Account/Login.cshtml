@model ITServiceAssetManagement.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<h2 class="text-2xl font-semibold mb-4">Login</h2>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="max-w-md">
    <div asp-validation-summary="All" class="field-error mb-2"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="flex items-center mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn-primary">Login</button>
</form>
