@model ITServiceAssetManagement.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<h2 class="text-2xl font-semibold mb-4">Register</h2>

<form asp-action="Register" method="post" class="max-w-md">
    <div asp-validation-summary="All" class="field-error mb-2"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" class="form-control">
            @foreach (var role in (string[])ViewBag.Roles)
            {
                <option value="@role">@role</option>
            }
        </select>
    </div>

    <button type="submit" class="btn-primary">Register</button>
</form>
