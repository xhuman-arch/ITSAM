@model ITServiceAssetManagement.Models.TicketCreateViewModel
@{
    ViewData["Title"] = "Buat Tiket";
}

<h2 class="text-2xl font-semibold mb-2">Buat Tiket Baru</h2>

<p class="text-muted2 text-sm mb-4">Estimasi batas waktu penyelesaian (SLA) akan dihitung otomatis berdasarkan prioritas yang dipilih.</p>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="max-w-md">
    <div asp-validation-summary="All" class="field-error mb-2"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" class="form-control">
            <option value="LOW">LOW (SLA 3 hari)</option>
            <option value="MEDIUM">MEDIUM (SLA 1 hari)</option>
            <option value="HIGH">HIGH (SLA 4 jam)</option>
        </select>
    </div>

    <div class="mb-4">
        <label asp-for="AssetId" class="form-label"></label>
        <select asp-for="AssetId" class="form-control">
            <option value="">-- Tidak ada --</option>
            @foreach (var asset in (List<ITServiceAssetManagement.Models.Entities.Asset>)ViewBag.Assets)
            {
                <option value="@asset.Id">@asset.AssetName</option>
            }
        </select>
    </div>

    <div class="mb-4">
        <label asp-for="AttachmentFile" class="form-label"></label>
        <input asp-for="AttachmentFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx" />
        <small class="text-muted2">Maksimal 5 MB. Format: jpg, png, gif, webp, pdf, doc, docx.</small>
    </div>

    <button type="submit" class="btn-primary">Kirim Tiket</button>
    <a asp-action="Index" class="btn-secondary">Batal</a>
</form>
