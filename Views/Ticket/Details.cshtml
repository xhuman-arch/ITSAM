@model ITServiceAssetManagement.Models.Entities.Ticket
@{
    ViewData["Title"] = "Detail Tiket";
}

<h2 class="text-2xl font-semibold mb-4">Detail Tiket</h2>

@if (TempData["Success"] != null)
{
    <div class="alert-success">@TempData["Success"]</div>
}
@if (TempData["UploadError"] != null)
{
    <div class="alert-warning">Lampiran gagal diupload: @TempData["UploadError"]</div>
}

@if (Model.IsOverdue)
{
    <div class="alert-danger">⚠ Tiket ini sudah melewati batas waktu SLA (@Model.DueDate?.ToString("dd-MM-yyyy HH:mm"))!</div>
}

<dl class="grid grid-cols-1 sm:grid-cols-4 gap-y-2 mb-4 max-w-lg">
    <dt class="sm:col-span-1 font-medium text-muted2">Judul</dt>
    <dd class="sm:col-span-3">@Model.Title</dd>

    <dt class="sm:col-span-1 font-medium text-muted2">Deskripsi</dt>
    <dd class="sm:col-span-3">@Model.Description</dd>

    <dt class="sm:col-span-1 font-medium text-muted2">Requester</dt>
    <dd class="sm:col-span-3">@Model.Requester?.FullName</dd>

    <dt class="sm:col-span-1 font-medium text-muted2">Asset</dt>
    <dd class="sm:col-span-3">@Model.Asset?.AssetName</dd>

    <dt class="sm:col-span-1 font-medium text-muted2">Prioritas</dt>
    <dd class="sm:col-span-3">@Model.Priority</dd>

    <dt class="sm:col-span-1 font-medium text-muted2">Status</dt>
    <dd class="sm:col-span-3"><span class="badge-info">@Model.Status</span></dd>

    <dt class="sm:col-span-1 font-medium text-muted2">Batas Waktu (SLA)</dt>
    <dd class="sm:col-span-3">
        @Model.DueDate?.ToString("dd-MM-yyyy HH:mm")
        @if (Model.IsOverdue)
        {
            <span class="badge-danger ml-1">OVERDUE</span>
        }
    </dd>
</dl>

@if (Model.Attachments.Any())
{
    <h4 class="text-lg font-semibold mb-2">Lampiran Tiket</h4>
    <ul class="list-disc list-inside mb-4 text-body2">
        @foreach (var att in Model.Attachments)
        {
            <li><a href="@att.FilePath" target="_blank" class="text-primary hover:underline">@att.FileName</a> <small class="text-muted2">(@att.UploadedAt.ToString("dd-MM-yyyy HH:mm"))</small></li>
        }
    </ul>
}

<hr class="my-4 border-base" />
<h4 class="text-lg font-semibold mb-2">Riwayat Assignment</h4>
<ul class="list-disc list-inside mb-4 text-body2">
    @foreach (var a in Model.TicketAssignments)
    {
        <li>@a.AssignedTo?.FullName - @a.Status - @a.AssignedAt.ToString("dd-MM-yyyy HH:mm")</li>
    }
</ul>

<h4 class="text-lg font-semibold mb-2">Riwayat Troubleshooting</h4>
<ul class="list-disc list-inside mb-4 text-body2">
    @foreach (var tr in Model.Troubleshootings)
    {
        <li>
            <strong>@tr.PerformedBy?.FullName</strong> (@tr.Result) - @tr.ActionTaken
            <br /><small class="text-muted2">@tr.PerformedAt.ToString("dd-MM-yyyy HH:mm")</small>
            @if (tr.Attachments.Any())
            {
                <ul class="list-disc list-inside ml-4">
                    @foreach (var att in tr.Attachments)
                    {
                        <li><a href="@att.FilePath" target="_blank" class="text-primary hover:underline">@att.FileName</a></li>
                    }
                </ul>
            }
        </li>
    }
</ul>

<h4 class="text-lg font-semibold mb-2">Pengajuan Penggantian</h4>
<ul class="list-disc list-inside mb-4 text-body2">
    @foreach (var r in Model.ReplacementRequests)
    {
        <li>@r.Reason - @r.Status</li>
    }
</ul>

<hr class="my-4 border-base" />
<div class="flex flex-wrap gap-2">
    @if (User.IsInRole("IT_SERVICE"))
    {
        <a asp-action="Assign" asp-route-id="@Model.Id" class="btn-warning">Assign ke IT Support</a>
    }

    @if (User.IsInRole("IT_SUPPORT"))
    {
        <a asp-action="AddTroubleshooting" asp-route-id="@Model.Id" class="btn-info">Tambah Troubleshooting</a>
        <a asp-controller="ReplacementRequest" asp-action="Create" asp-route-ticketId="@Model.Id" asp-route-assetId="@Model.AssetId" class="btn-secondary">Ajukan Penggantian Asset</a>
    }

    @if ((User.IsInRole("IT_SERVICE") || User.IsInRole("IT_SUPPORT")) && Model.Status != "CLOSED")
    {
        <form asp-action="Close" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn-dark">Tutup Tiket</button>
        </form>
    }
</div>

<a asp-action="Index" class="btn-link mt-3 inline-block">Kembali ke Daftar</a>
