@model ITServiceAssetManagement.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="text-2xl font-semibold">Dashboard</h2>
<p class="text-muted2 mb-4">Halo, @User.Identity!.Name</p>

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="card-stat">
        <h6 class="text-sm text-muted2">Total Tiket</h6>
        <h2 class="text-2xl font-semibold text-ink">@Model.TotalTickets</h2>
    </div>
    <div class="card-stat">
        <h6 class="text-sm text-muted2">Open</h6>
        <h2 class="text-2xl font-semibold text-ink">@Model.OpenTickets</h2>
    </div>
    <div class="card-stat">
        <h6 class="text-sm text-muted2">In Progress</h6>
        <h2 class="text-2xl font-semibold text-ink">@Model.InProgressTickets</h2>
    </div>
    <div class="card-stat">
        <h6 class="text-sm text-muted2">Resolved / Closed</h6>
        <h2 class="text-2xl font-semibold text-ink">@(Model.ResolvedTickets + Model.ClosedTickets)</h2>
    </div>
</div>

@if (Model.OverdueTickets > 0)
{
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="card-border-danger">
            <h6 class="text-sm text-muted2">⚠ Tiket Overdue (Lewat SLA)</h6>
            <h2 class="text-2xl font-semibold text-danger mb-2">@Model.OverdueTickets</h2>
            <a asp-controller="Ticket" asp-action="Index" asp-route-overdueOnly="true" class="btn-outline-danger btn-sm">Lihat</a>
        </div>
    </div>
}

@if (User.IsInRole("IT_SERVICE"))
{
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="card-border-danger">
            <h6 class="text-sm text-muted2">Tiket Belum Ditugaskan</h6>
            <h2 class="text-2xl font-semibold text-danger mb-2">@Model.UnassignedTickets</h2>
            <a asp-controller="Ticket" asp-action="Index" asp-route-status="OPEN" class="btn-outline-danger btn-sm">Lihat</a>
        </div>
    </div>
}

@if (User.IsInRole("IT_SUPPORT"))
{
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="card-border-info">
            <h6 class="text-sm text-muted2">Tiket Ditugaskan ke Saya</h6>
            <h2 class="text-2xl font-semibold text-ink">@Model.MyAssignedTickets</h2>
        </div>
        <div class="card-border-warning">
            <h6 class="text-sm text-muted2">Sedang Saya Kerjakan</h6>
            <h2 class="text-2xl font-semibold text-ink">@Model.MyOpenTickets</h2>
        </div>
    </div>
}

@if (User.IsInRole("IT_SERVICE") || User.IsInRole("IT_SUPPORT"))
{
    <h4 class="text-lg font-semibold mb-2">Ringkasan Asset</h4>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 mb-6">
        <div class="card-border-plain">
            <h6 class="text-sm text-muted2">Total Asset</h6>
            <h2 class="text-2xl font-semibold text-ink">@Model.TotalAssets</h2>
        </div>
        <div class="card-border-success">
            <h6 class="text-sm text-muted2">Active</h6>
            <h2 class="text-2xl font-semibold text-ink">@Model.ActiveAssets</h2>
        </div>
        <div class="card-border-warning">
            <h6 class="text-sm text-muted2">In Repair</h6>
            <h2 class="text-2xl font-semibold text-ink">@Model.InRepairAssets</h2>
        </div>
        <div class="card-border-secondary">
            <h6 class="text-sm text-muted2">Retired</h6>
            <h2 class="text-2xl font-semibold text-ink">@Model.RetiredAssets</h2>
        </div>
    </div>
}

@if (User.IsInRole("PURCHASING") || User.IsInRole("IT_SERVICE") || User.IsInRole("IT_SUPPORT"))
{
    <h4 class="text-lg font-semibold mb-2">Replacement Request</h4>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 mb-6">
        <div class="card-border-plain">
            <h6 class="text-sm text-muted2">Total Pengajuan</h6>
            <h2 class="text-2xl font-semibold text-ink">@Model.TotalReplacementRequests</h2>
        </div>
        <div class="card-border-danger">
            <h6 class="text-sm text-muted2">Pending</h6>
            <h2 class="text-2xl font-semibold text-danger mb-2">@Model.PendingReplacementRequests</h2>
            <a asp-controller="ReplacementRequest" asp-action="Index" asp-route-status="PENDING" class="btn-outline-danger btn-sm">Lihat</a>
        </div>
    </div>
}
